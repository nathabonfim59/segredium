[Unit]
Description=segredium (AWS Secrets Manager compatible server)
Documentation=https://github.com/nathabonfim59/segredium
After=network.target

[Service]
ExecStart=/usr/bin/segredium serve -config /etc/segredium/segredium.yaml
Restart=on-failure
RestartSec=2
# Binds :443 and keeps its CA and data under /var/lib/segredium.
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=segredium
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/segredium

[Install]
WantedBy=multi-user.target
